# --- 1.0 groups — pinned but NOT BUILT by NOM-258 ---------------------------
# Carried so the file does not have to be rebuilt when the group ships.
# DIGESTS NOT YET RESOLVED: these are 1.0 scope and NOM-258 builds MVP only.
# A `later`/`1.0` image with an unresolved digest must never be referenced by a
# shipped compose profile; CI I4 enforces that over the MVP profiles only.
WHISPER_IMAGE=ghcr.io/ggml-org/whisper.cpp
WHISPER_TAG=UNRESOLVED
WHISPER_DIGEST=UNRESOLVED
