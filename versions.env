# LiteLLM >= 1.105.1 clears GHSA-7hp6 (CVSS 9.9) and GHSA-4xpc [V-249].
# Pinned AT the verified floor, not above it: 1.106/1.107 exist upstream but
# nothing in this design verified them.  Renovate proposes bumps; a bump is a
# reviewed PR, not a default.  MCP features off.
LITELLM_IMAGE=ghcr.io/berriai/litellm
LITELLM_TAG=v1.105.1
LITELLM_DIGEST=sha256:b7b9e2c306343721802253d0dd9436b9634a2eb4e14da7c7cf06c5c7b7530802
LITELLM_KIND=advisory-floor-exact
LITELLM_CHECKED=2026-10-18
LITELLM_COSIGN=unprobed

