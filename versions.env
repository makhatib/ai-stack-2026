# AI Stack 2026 — image pins.  COMMITTED, Renovate-managed (final-design §7.1).
#
# Every reference in compose is ${X_TAG:?pin missing}@${X_DIGEST:?pin missing},
# so a missing pin fails closed instead of silently resolving to :latest.
#
# Per image this file carries: the tag, the registry digest, whether the version
# is a LATEST PUBLISHED RELEASE or a LATEST TAG, and the date the digest was
# checked.  `aistack install|update|pin` renders this into a delimited block in
# the generated .env; CI (I4) asserts the rendered block matches this file, and
# `aistack doctor` re-checks — which is what catches a Renovate PR merged
# without a re-render.
#
# SUPPLY-CHAIN POSTURE, STATED HONESTLY (final-design §7.1):
#   DIGEST PINNING IS THE CONTROL.  `cosign verify` runs opportunistically, only
#   for the upstreams that publish signatures, listed per image below.  There is
#   no blanket "images are verified" claim and this file will not make one.
#
# Digests below were resolved on 2026-10-18 from the live registries with
# `docker buildx imagetools inspect` on AI-Sandbox.  Each is the MULTI-ARCH
# INDEX digest, which is what `docker pull <ref>@<digest>` takes.
#
# VERIFIED: the tag->digest mapping (measured).
# [A]:      cosign signature availability per upstream — NOM-258 has not probed
#           each upstream's signing posture; the column below says "unprobed"
#           rather than "unsigned", because those are different claims.

# --- core (8) ---------------------------------------------------------------

# Caddy 2.11.7 — official unmodified image.  NO xcaddy build anywhere in v1 (S12).
CADDY_IMAGE=docker.io/library/caddy
CADDY_TAG=2.11.7
CADDY_DIGEST=sha256:685ae3d7c34d9b5f8caeddc5d14051db7bbd88ff1f5a2fa0c16bd8ca328fb7af
CADDY_KIND=latest-published-release
CADDY_CHECKED=2026-10-18
CADDY_COSIGN=unprobed

# Authelia 4.39.28 — OIDC provider is open beta with no single-logout [V-252],
# which is why forward-auth is primary and OIDC is secondary.
AUTHELIA_IMAGE=docker.io/authelia/authelia
AUTHELIA_TAG=4.39.28
AUTHELIA_DIGEST=sha256:bd97cff4fcbf715b5ff1f9ae286afbe6033afce385302520b0368122d43a6f54
AUTHELIA_KIND=latest-published-release
AUTHELIA_CHECKED=2026-10-18
AUTHELIA_COSIGN=unprobed

# PostgreSQL 17 + pgvector 0.8.7.  One datastore, one backup procedure, a
# database and a NON-SUPERUSER ROLE PER APP.
#
# THE -trixie VARIANT (Debian 13), NOT the default bookworm one.  This was
# V7's `measured_alternative` and it is now APPLIED: the Tech Lead decided
# yes on NOM-341.  It trades CRITICAL units 8 -> 2 for HIGH 20 -> 28,
# measured at this exact digest in security-report-bump-20261019T060718Z.
#
# THE OPERATIONAL CONDITION THAT CAME WITH THE DECISION (V7 `recommendation`):
# Debian 13 carries a glibc collation change.  Taking this on a FRESH install
# is a non-issue and the MVP installs fresh.  Taking it as an in-place base
# swap under an EXISTING PGDATA requires a REINDEX, and nothing in this repo
# performs one.  Do not move an existing cluster onto this pin without that
# plan.
POSTGRES_IMAGE=docker.io/pgvector/pgvector
POSTGRES_TAG=0.8.7-pg17-trixie
POSTGRES_DIGEST=sha256:7a7e9f22015b67edb4bef5c59daeebcd7e74bfa570df6ce60ae01237c8648a84
POSTGRES_KIND=latest-published-release
POSTGRES_CHECKED=2026-10-20
POSTGRES_COSIGN=unprobed

# Homepage >= 2.6.0 MANDATORY: GHSA-qxcr-4rv3-v23r auth-gate bypass [V-252].
HOMEPAGE_IMAGE=ghcr.io/gethomepage/homepage
HOMEPAGE_TAG=v2.6.0
HOMEPAGE_DIGEST=sha256:3e38fe788223cb46a3ce1f046ef11667b40f7707fdca0dcbfa3f86c5c42bf1e8
HOMEPAGE_KIND=latest-published-release
HOMEPAGE_CHECKED=2026-10-18
HOMEPAGE_COSIGN=unprobed

