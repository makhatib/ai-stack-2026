# AI Stack 2026 — host packages VPS mode installs (NOM-414).  PINNED.
#
# These are APT package versions for Ubuntu 24.04 (noble), not image digests,
# so they are not in versions.env and not covered by invariant I4's pin block.
# Docker and Compose are the versions the stack was built and tested against
# (NOM-303 target: Docker 29.2.1, Compose 5.0.2).  Re-check on recording day:
#   apt-cache madison docker-ce docker-compose-plugin containerd.io tailscale
#
# The installer holds these packages (apt-mark hold) so an unattended upgrade
# cannot move the container runtime under a running stack.
DOCKER_CE_VERSION=5:29.2.1-1~ubuntu.24.04~noble
DOCKER_COMPOSE_PLUGIN_VERSION=5.0.2-1~ubuntu.24.04~noble
CONTAINERD_VERSION=2.4.2-3~ubuntu.24.04~noble
# Used only with --tailscale (off by default).
TAILSCALE_VERSION=__RESOLVE_ME__
