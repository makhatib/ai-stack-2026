# AI Stack 2026 — Authelia users.  FILE BACKEND: no self-registration surface.
#
# `./install.sh` writes the real users.yml from this template as PHASE 1 of the
# two-phase owner bootstrap (S05):
#
#   PHASE 1 (installer)  one owner account with a RANDOM password, written
#                        here as an argon2id hash and NEVER printed, and no
#                        second factor enrolled.
#   PHASE 2 (operator)   `aistack user reset owner` sets a password the owner
#                        chooses, at a prompt, and then their first login
#                        enrols a second factor.  Both halves are needed:
#                        every route is `two_factor`, so a correct password
#                        with no enrolled factor opens nothing.
#
# There is therefore no window in which an account exists that can open a
# service using a password the installer printed — because the installer never
# prints one, and the one it did write is not recoverable by anybody.
#
# PHASE 2 IS A COMMAND, NOT A WEB FLOW.  An earlier version of this comment
# said Authelia forces a password change at first login.  It does not: the file
# backend has no such flag, and the web reset flow is disabled in
# configuration.yml because there is no SMTP.  `aistack user` is the path, and
# `aistack user list` shows which accounts still have phase 2 outstanding.
# [NOM-402]
#
# After `aistack user` has edited the real users.yml, the per-account comments
# below are not carried over -- the file is regenerated from its own contents
# with this header kept and the accounts re-emitted.  This template is what a
# FRESH install starts from; it is not a picture of a file in use.
users:
  owner:
    displayname: "Owner"
    # argon2id hash, written by the installer, replaced by `aistack user reset`.
    # NEVER a plaintext password.
    password: "__ARGON2_HASH_WRITTEN_BY_INSTALLER__"
    email: owner@localhost
    groups:
      - admins
      - owner
