{
  "name": "W1 — Research over a local corpus (NO internet)",
  "nodes": [
    {
      "parameters": {},
      "id": "w1-manual",
      "name": "Run manually",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://litellm:4000/v1/embeddings",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'local-embed', input: $json.question }) }}",
        "options": { "timeout": 60000 }
      },
      "id": "w1-embed-q",
      "name": "Embed the question",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [220, 0]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT source, content FROM w2_chunks ORDER BY embedding <-> $1::vector LIMIT 5",
        "options": {}
      },
      "id": "w1-search",
      "name": "Nearest chunks (pgvector)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.4,
      "position": [440, 0],
      "notes": "THE CORPUS IS LOCAL AND PRELOADED. This demo needs no internet and gets none: Open WebUI's web search is off in every profile and there is no web-search group in this release. The internet-backed version of this demo is a LATER release, not a setting."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://litellm:4000/v1/chat/completions",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'local-chat', messages: [{ role: 'user', content: 'Answer using ONLY this context. Cite the source of each claim.\\n\\n' + JSON.stringify($input.all().map(i => i.json)) }], max_tokens: 512 }) }}",
        "options": { "timeout": 120000 }
      },
      "id": "w1-answer",
      "name": "Answer with citations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [660, 0]
    }
  ],
  "connections": {
    "Run manually": { "main": [[{ "node": "Embed the question", "type": "main", "index": 0 }]] },
    "Embed the question": { "main": [[{ "node": "Nearest chunks (pgvector)", "type": "main", "index": 0 }]] },
    "Nearest chunks (pgvector)": { "main": [[{ "node": "Answer with citations", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionTimeout": 300 },
  "active": false
}
