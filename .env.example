# AI Stack 2026 — .env.example
#
# COPY TO `.env` AND EDIT, or let `aistack install` write it for you.
#
# THERE ARE NO SECRETS IN THIS FILE AND THERE NEVER WILL BE.  Every secret the
# stack needs is generated by `scripts/gen-secrets.sh` into `secrets/`, which is
# 0700 root:root and git-ignored.  Services read them as Compose file secrets at
# /run/secrets/<name>, except Open WebUI and LiteLLM, which have no _FILE
# indirection upstream and therefore read a root-owned 0640 env_file — that is
# exception E6, and the env_file is NOT this file.
#
# The database passwords below are an exception that is NOT a secret leak: they
# are read from secrets/app_db_passwords by the installer and written into .env
# only because Compose interpolates connection strings at render time.  `.env`
# is 0600 root:root.  If that bothers you, it should — it is the reason E6
# exists and the reason the exceptions register names it rather than hiding it.

# ---------------------------------------------------------------------------
# Where the stack listens.  LOCAL MODE.
# ---------------------------------------------------------------------------
# The ONE hostname Caddy serves.  Use a name that resolves on your own machine
# (an /etc/hosts entry is fine).  Caddy issues an internal-CA certificate for
# it; there is no ACME, no public DNS and no Certificate Transparency entry.
AISTACK_HOSTNAME=aistack.localhost

# The address the published ports bind to.  NEVER 0.0.0.0 and never ::.
#   127.0.0.1        this machine only — the only configuration A1-local covers
#   192.168.x.y      your LAN address, if you want other devices to try
#
# AISTACK-LOCAL-MODE:BEGIN
# Not published to the internet. Reachable on this machine; reachable from other devices on your network if your network allows it — we have not tested that.
# AISTACK-LOCAL-MODE:END
AISTACK_BIND_ADDR=127.0.0.1

# Used for Caddy's internal CA bookkeeping only.  No mail is ever sent: there
# is no SMTP in this release.
AISTACK_ADMIN_EMAIL=admin@localhost

AISTACK_TZ=UTC

# ---------------------------------------------------------------------------
# Profile.  Generated from manifest.yaml — do not hand-edit the count.
# ---------------------------------------------------------------------------
#   (empty)      Starter          14 containers
#   knowledge    AI Automation    15 containers
#   + openclaw (+2), voice-arabic (+2), docs-arabic (replaces knowledge's parser)
#
# `agents` is NOT selectable: gate G-AGENTS failed on 2026-10-18 against the
# pinned agentgateway digest, so the group is deferred.  See
# gate/G-AGENTS-result.json and docs/security-faq.md.  An installer screen for
# a deferred group is how a deferred group comes back, so there is not one.
COMPOSE_PROFILES=knowledge

# ---------------------------------------------------------------------------
# Database connection strings.  Written by the installer from
# secrets/app_db_passwords.  Leave the placeholders alone if you are letting
# `aistack install` do it.
# ---------------------------------------------------------------------------
OPENWEBUI_DB_PASSWORD=__WRITTEN_BY_INSTALLER__
LITELLM_DB_PASSWORD=__WRITTEN_BY_INSTALLER__
N8N_DB_PASSWORD=__WRITTEN_BY_INSTALLER__
LANGFUSE_DB_PASSWORD=__WRITTEN_BY_INSTALLER__

# ---------------------------------------------------------------------------
# AISTACK-PINS:BEGIN
# RENDERED FROM versions.env BY `aistack install|update|pin`.  DO NOT EDIT.
# CI invariant I4 asserts this block matches versions.env byte for byte, and
# `aistack doctor` re-checks it — which is what catches a Renovate PR merged
# without a re-render.  Hand-editing a digest here and not in versions.env is
# the exact failure this block exists to make loud.
# AISTACK-PINS:END
# ---------------------------------------------------------------------------
