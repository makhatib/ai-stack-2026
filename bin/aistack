#!/usr/bin/env bash
# AI Stack 2026 — the one command.
#
# Lifecycle, status and support live here so that no viewer ever has to type a
# raw `docker compose` line with the right -f flags in the right order.
#
# TWO LOCKS, AND EVERY PATH TAKES THEM IN ONE ORDER: lifecycle, then helper
# (final-design §2.1).  A process that already holds one passes its open file
# descriptor down through AISTACK_LOCK_FD_LIFECYCLE / AISTACK_LOCK_FD_HELPER,
# and the wrapper SKIPS acquisition when the variable is set — so `aistack up`
# running a helper under its own held lock cannot deadlock against itself.
# ci/i14_lock_order.sh greps the command implementations for the other order.

set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# Where the two locks live.  NOT unconditionally /run/aistack: that needs root
# to create, and asking for sudo to take a lock would make `aistack up` a
# privileged operation on a stack whose whole point is that it is not one.  It
# would also break rootless Docker, which 1.0 wants at Tier A.
#
# Both candidates are tmpfs, which is what the design relies on: flock is
# released by the kernel when the holder dies, and a reboot clears the lock
# entirely, so there is no stale-lock state to clean up.
#
# AND IT IS DERIVED FROM THE OPERATOR, NOT FROM WHOEVER IS CALLING.
#
# MEASURED (NOM-258, 2026-10-18).  The first version picked by the CALLER's
# privilege, which split the lock in two:
#
#     ai   -> /run/user/1000/aistack        (XDG_RUNTIME_DIR)
#     root -> /run/aistack                  (/run is writable)
#
# `aistack up` runs as the operator; `sudo bin/aistack backup` is what
# backup.sh itself tells you to run, because a complete backup has to read
# root-owned per-service secrets.  So the two commands this lock exists to
# keep apart were the two guaranteed to take DIFFERENT locks — a restore could
# run concurrently with an up and neither would wait.  Nothing fails loudly;
# the exclusion is simply absent, which is this comment's own "silently defeat
# the whole mutual-exclusion design".
#
# The operator's runtime directory is the one path both identities agree on
# AND both can write: it exists for the logged-in operator, and root can write
# anywhere.  `$(id -u)` is deliberately not used here — that is the bug.
#
# Two defects, one fix: `[ -w /run ] || [ -d … ] && [ -w … ]` also parses as
# `(A || B) && C`, so root chose /run/aistack only when it ALREADY existed and
# otherwise fell through — the opposite of the intent.
pick_rundir() {
  if [ -n "${AISTACK_RUNDIR:-}" ]; then printf '%s' "$AISTACK_RUNDIR"; return; fi
  local ouid
  ouid="$(stat -c %u "$ROOT" 2>/dev/null || true)"; : "${ouid:=$(id -u)}"
  if [ -d "/run/user/$ouid" ] && [ -w "/run/user/$ouid" ]; then
    printf '/run/user/%s/aistack' "$ouid"; return
  fi
  # No logind session for the operator (a service account, or a container).
  # /run/aistack is then the shared path, and ensure_rundir hands it to the
  # operator when root is the one who gets there first.
  if { [ -d /run/aistack ] && [ -w /run/aistack ]; } || [ -w /run ]; then
    printf '/run/aistack'; return
  fi
  printf '/tmp/aistack-%s' "$ouid"
}
RUNDIR="$(pick_rundir)"
# Exported so every script this CLI invokes agrees on where the locks live.
# Letting each one re-derive it is how a drill ends up taking a different
# lock from the serving supervisor, which would silently defeat the whole
# mutual-exclusion design.
export AISTACK_RUNDIR="$RUNDIR"
LIFECYCLE_LOCK="$RUNDIR/lifecycle.lock"
HELPER_LOCK="$RUNDIR/helper.lock"

die()  { printf 'aistack: %s\n' "$*" >&2; exit 1; }
info() { printf '%s\n' "$*"; }

[ -f "$ROOT/compose.yaml" ] || die "no compose.yaml at $ROOT"

ensure_rundir() {
  # MEASURED (NOM-258, 2026-10-18).  Two defects, both found by running a real
  # root-shell install and then typing a command as the operator.
  #
  # 1. Handing over the DIRECTORY is not enough.  The lock files are created
  #    later, by `exec {fd}>>"$LIFECYCLE_LOCK"`, so a root-run install left
  #       /run/user/1000/aistack/lifecycle.lock   root:root 0644
  #    inside a 0770 operator-owned directory, and the operator's very next
  #    command died with a bare
  #       bin/aistack: line 118: .../lifecycle.lock: Permission denied
  #    That is the same class as the root-owned .env, one layer further in:
  #    the install succeeds and the stack is unusable by the person who owns
  #    it.  So the lock FILES are created here and handed over too.
  #
  # 2. The old early return -- `[ -d "$RUNDIR" ] && [ -w "$RUNDIR" ] && return`
  #    -- skipped the handover whenever the directory already existed.  root
  #    can write any directory, so for root that test is always true and the
  #    chown ran only on the very first invocation.  The handover is now
  #    idempotent and runs every time root is the caller.
  if ! [ -d "$RUNDIR" ] && ! mkdir -p "$RUNDIR" 2>/dev/null; then
  die "cannot create a lock directory at $RUNDIR.
Set AISTACK_RUNDIR to a writable path on a tmpfs and try again.
It must be a tmpfs: the locks are released by the kernel when a holder dies,
and a reboot must clear them, so a lock file on persistent storage would
survive a crash as state nobody cleans up."
  fi

  local ouid ogid f
  ouid="$(stat -c %u "$ROOT" 2>/dev/null || true)"
  ogid="$(stat -c %g "$ROOT" 2>/dev/null || true)"
  # Create, never truncate: an existing lock may be held right now.
  for f in "$LIFECYCLE_LOCK" "$HELPER_LOCK"; do
    [ -e "$f" ] || : > "$f" 2>/dev/null || true
  done
  if [ "$(id -u)" = "0" ] && [ -n "$ouid" ] && [ "$ouid" != "0" ]; then
    chown "$ouid:$ogid" "$RUNDIR" 2>/dev/null || true
    chmod 0770 "$RUNDIR" 2>/dev/null || true
    for f in "$LIFECYCLE_LOCK" "$HELPER_LOCK"; do
      [ -e "$f" ] || continue
      chown "$ouid:$ogid" "$f" 2>/dev/null || true
      chmod 0660 "$f" 2>/dev/null || true
    done
  fi
  # Assert the outcome rather than assuming the chown worked.  A lock we
  # cannot write is not a lock, and failing here beats failing later with a
  # bare "Permission denied" from a redirect.
  [ -w "$RUNDIR" ] || die "the lock directory $RUNDIR is not writable by $(id -un).
If a root-shell install created it, re-run that install from this commit or
remove the directory and try again."
  for f in "$LIFECYCLE_LOCK" "$HELPER_LOCK"; do
    [ ! -e "$f" ] || [ -w "$f" ] || die "the lock file $f is not writable by $(id -un).
A root-shell install created it before this fix.  Remove it and try again:
  sudo rm -f $f"
  done
  return 0
}

dc() {
  # One place that knows the compose invocation.  Every caller goes through it,
  # so there is exactly one definition of "the project".
  ( cd "$ROOT" && docker compose "$@" )
}

# --- locks ------------------------------------------------------------------
# Order: LIFECYCLE, then HELPER.  Never the reverse.

with_lifecycle_lock() {
  # $1 = sh|ex, rest = command
  local mode="$1"; shift
  if [ -n "${AISTACK_LOCK_FD_LIFECYCLE:-}" ]; then
    "$@"; return $?
  fi
  ensure_rundir
  exec {fd}>>"$LIFECYCLE_LOCK"
  local flag=-s; [ "$mode" = ex ] && flag=-x
  flock "$flag" "$fd" || die "could not take the lifecycle lock"
  AISTACK_LOCK_FD_LIFECYCLE="$fd" "$@"
  local rc=$?
  exec {fd}>&-
  return $rc
}

with_helper_lock() {
  # At most ONE helper exists at any instant.  `aistack up` holds this too, so
  # no helper runs during startup verification.
  if [ -n "${AISTACK_LOCK_FD_HELPER:-}" ]; then
    "$@"; return $?
  fi
  ensure_rundir
  exec {fd}>>"$HELPER_LOCK"
  flock -x "$fd" || die "another helper is running; at most one may exist at a time"
  AISTACK_LOCK_FD_HELPER="$fd" "$@"
  local rc=$?
  exec {fd}>&-
  return $rc
}

# --- pins -------------------------------------------------------------------

render_pins() {
  # Render versions.env into the delimited block in .env.  I4 asserts the
  # rendered block matches the source; `doctor` re-checks, which catches a
  # Renovate PR merged without a re-render.
  local env="$ROOT/.env"
  [ -f "$env" ] || die ".env not found — run 'aistack install' first"
  python3 - "$ROOT/versions.env" "$env" <<'PY'
import sys, re
src, env = sys.argv[1], sys.argv[2]
pins = []
for line in open(src):
    s = line.strip()
    if not s or s.startswith("#"):
        continue
    if re.match(r'^[A-Z0-9_]+=', s):
        pins.append(s)
block = (
    "# AISTACK-PINS:BEGIN\n"
    "# RENDERED FROM versions.env BY `aistack install|update|pin`.  DO NOT EDIT.\n"
    + "\n".join(pins) + "\n"
    "# AISTACK-PINS:END\n"
)
text = open(env).read()
pat = re.compile(r"# AISTACK-PINS:BEGIN.*?# AISTACK-PINS:END\n", re.S)
if pat.search(text):
    text = pat.sub(block, text)
else:
    text = text.rstrip("\n") + "\n\n" + block
open(env, "w").write(text)
print("rendered %d pins into .env" % len(pins))
PY
  chmod 0600 "$env"
}

# --- commands ---------------------------------------------------------------

cmd_up() {
  with_lifecycle_lock sh _up "$@"
}
_up() {
  # The drill must be excluded BY THE LOCK MODE, not by a count of holders.
  # We hold shared; the drill holds exclusive; the kernel serialises them.
  # The opposing-project check runs INSIDE the hold, which is what closes the
  # check-then-act race.
  if docker ps -a --format '{{.Names}}' | grep -q '^restore-drill-'; then
    die "a restore drill is running or was left behind: $(docker ps -a --format '{{.Names}}' | grep '^restore-drill-' | tr '\n' ' ')
Serving will not start while drill containers exist.  Run 'aistack drill clean'."
  fi
  info "Starting (profiles: ${COMPOSE_PROFILES:-$(grep -E '^COMPOSE_PROFILES=' "$ROOT/.env" 2>/dev/null | cut -d= -f2-)})"
  # `compose up` CAN FAIL BEFORE THE HEALTH GATE EVER RUNS, and when it does
  # its last line names the wrong thing.
  #
  # MEASURED (NOM-307, 2026-10-19): a half-initialised Postgres ended the
  # install with
  #     dependency failed to start: container aistack-postgres is unhealthy
  # naming the one service that was, by its own probe at that moment, fine —
  # while the actual cause was seven WARN lines from gen-secrets.sh earlier in
  # the same log.  With `set -e` this used to abort the function here and the
  # explanation below never ran at all.
  if ! dc up -d --remove-orphans; then
    info ""
    info "'docker compose up' gave up.  What each container itself reports:"
    _explain_unhealthy
    return 1
  fi
  _health_gate
}

# The state of every container, as one line of `service container state health`.
#
# IT FAILS INSTEAD OF RETURNING NOTHING.  The previous version swallowed every
# exception per line and printed an empty list, so a `compose ps` that errored
# — or that one day emits a JSON array instead of one object per line —
# produced zero bad services and the gate said "All services healthy."  That
# is the same shape of defect as NOM-307's silent `except ImportError`: an
# unanswered question read as a reassuring answer.
_service_table() {
  local json
  json="$(dc ps "$@" --format json 2>/dev/null)" || return 1
  [ -n "$json" ] || return 1
  printf '%s\n' "$json" | python3 -c '
import json, sys
rows = []
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    d = json.loads(line)          # a shape we cannot parse is an ERROR, not "healthy"
    rows.append((d.get("Service") or "?", d.get("Name") or "?",
                 (d.get("State") or "").lower(), (d.get("Health") or "").lower()))
if not rows:
    sys.exit(3)
for r in rows:
    print(*r)
'
}

_not_ready() {
  # $1 = the table.  A service is not ready when it is not running, or it has
  # a probe that is starting or failing.
  printf '%s\n' "$1" | awk '$3!="running" || $4=="starting" || $4=="unhealthy" {print $1}'
}

# WHAT THE CONTAINER SAYS ABOUT ITSELF, not what compose concluded.
#
# The last health-probe OUTPUT is printed first and deliberately: it is the one
# line that names a cause.  config/postgres/healthcheck.sh, for instance, says
# which roles and databases are missing and which command repairs them, and
# none of that reaches the terminal if only `docker compose`'s own summary is
# shown.
_explain_unhealthy() {
  local table svc name
  if ! table="$(_service_table -a)"; then
    info "  (could not read 'docker compose ps' — try: docker compose ps -a)"
    return 0
  fi
  printf '%s\n' "$table" | awk '{printf "  %-16s %-24s %s%s\n", $1, $2, $3, ($4=="" ? "" : "/" $4)}'
  for svc in $(_not_ready "$table"); do
    name="$(printf '%s\n' "$table" | awk -v s="$svc" '$1==s {print $2; exit}')"
    info ""
    info "--- $svc: last health-probe output ---"
    docker inspect --format \
      '{{range .State.Health.Log}}exit {{.ExitCode}}: {{.Output}}{{end}}' "$name" 2>/dev/null \
      | tail -12 | "$ROOT/scripts/redact.sh" || info "  (no healthcheck on this service)"
    info "--- $svc: last 50 log lines (redacted) ---"
    dc logs --tail 50 "$svc" 2>&1 | "$ROOT/scripts/redact.sh" || true
  done
  info ""
  info "To roll back to the previous pins:   aistack rollback"
  info "To collect a shareable artefact:     aistack support-bundle"
}

_health_gate() {
  # Bounded.  A health gate that waits forever is a hang with a progress bar.
  local deadline=$(( SECONDS + 300 )) table unhealthy
  info "Waiting for health (up to 300s)..."
  while [ "$SECONDS" -lt "$deadline" ]; do
    if ! table="$(_service_table)"; then
      info ""
      info "COULD NOT READ THE STACK'S STATE from 'docker compose ps'."
      info "That is not a pass.  Run 'docker compose ps' here and look at the error."
      return 1
    fi
    unhealthy="$(_not_ready "$table" | tr '\n' ' ')"
    [ -z "${unhealthy// /}" ] && { info "All services healthy."; return 0; }
    sleep 5
  done
  # Name the service and print its last health output and 50 REDACTED log
  # lines, plus the exact rollback command.  A health-gate failure that says
  # only "unhealthy" sends the viewer to a screenshot of their terminal, which
  # is the thing support-bundle exists to replace.
  info ""
  info "NOT HEALTHY after 300s: $unhealthy"
  _explain_unhealthy
  return 1
}

cmd_down()    { with_lifecycle_lock ex dc down --remove-orphans; }
cmd_restart() { cmd_down; cmd_up; }
cmd_logs()    { dc logs "${@:---tail=200}" | "$ROOT/scripts/redact.sh"; }
cmd_config()  { dc config "$@"; }
cmd_ps()      { dc ps; }

cmd_status() {
  # Steady-state and helper counts are printed SEPARATELY, and the lifecycle
  # mode currently held is named (final-design §2.1).  One number could not
  # carry all three honestly.
  local steady helpers mode
  steady="$(dc ps --services --filter status=running 2>/dev/null | grep -vc -E '^(model-puller|backup-helper|agentgateway-verify)$' || true)"
  helpers="$(docker ps --format '{{.Names}}' | grep -cE '^aistack-(model-puller|backup-helper|agentgateway-verify)' || true)"
  if   [ -e "$LIFECYCLE_LOCK" ] && flock -n -x "$LIFECYCLE_LOCK" true 2>/dev/null; then mode="free"
  elif [ -e "$LIFECYCLE_LOCK" ] && flock -n -s "$LIFECYCLE_LOCK" true 2>/dev/null; then mode="shared (serving)"
  elif [ -e "$LIFECYCLE_LOCK" ]; then mode="exclusive (a drill holds it)"
  else mode="free (no lock file)"; fi

  printf '\nAI Stack 2026\n'
  printf '  steady-state services running : %s\n' "${steady:-0}"
  printf '  helpers running               : %s   (ceiling 1 — the helper lock)\n' "${helpers:-0}"
  printf '  lifecycle lock                : %s\n' "$mode"
  printf '  profiles                      : %s\n' "$(grep -E '^COMPOSE_PROFILES=' "$ROOT/.env" 2>/dev/null | cut -d= -f2- || echo '(none)')"
  printf '\n'
  sed -n '/AISTACK-LOCAL-MODE:BEGIN/,/AISTACK-LOCAL-MODE:END/p' "$ROOT/.env" 2>/dev/null \
    | grep -v 'AISTACK-LOCAL-MODE' | sed 's/^# \?/  /'
  printf '\n'
  dc ps
}

cmd_models() {
  case "${1:-}" in
    pull)
      shift
      [ $# -ge 1 ] || die "usage: aistack models pull <name>"
      with_lifecycle_lock sh with_helper_lock _model_pull "$@"
      ;;
    list) docker run --rm --network aistack-inference \
            "${OLLAMA_IMAGE}:${OLLAMA_TAG}@${OLLAMA_DIGEST}" \
            sh -c 'OLLAMA_HOST=http://ollama:11434 ollama list' ;;
    *) die "usage: aistack models {pull <name>|list}" ;;
  esac
}
_model_pull() {
  # Ollama itself sits on `inference`, which is internal and has NO route off
  # the host.  The puller is a SHORT-LIVED helper on `egress` writing the same
  # named volume.  Pulling a model from the Open WebUI UI does not work, and
  # the docs say so rather than leaving the viewer to discover it.
  local name="$1"
  # shellcheck disable=SC1091
  source "$ROOT/versions.env"

  # The `egress` bridge is created HERE, for the life of the helper, rather
  # than declared in compose.
  #
  # This is deliberate and it is stronger than the declared form: compose
  # prunes a network no service references, so declaring `egress` there and
  # attaching nothing to it produced a bridge that either did not exist or
  # existed permanently depending on compose's mood.  Creating it per-pull
  # means THE ONE NAT-CAPABLE BRIDGE IN THE STACK DOES NOT EXIST AT STEADY
  # STATE AT ALL.  `edge` is then the only non-internal bridge while the stack
  # is merely running, which is a smaller surface than the design assumed, and
  # I11 checks the flags of whichever bridges exist.
  if ! docker network inspect aistack-egress >/dev/null 2>&1; then
    docker network create --subnet 172.31.246.0/29 aistack-egress >/dev/null
  fi
  trap 'docker network rm aistack-egress >/dev/null 2>&1 || true' RETURN

  info "Pulling '$name' through the model-puller helper (egress), not through Ollama."
  docker run --rm --name aistack-model-puller \
    --network aistack-egress \
    -v aistack-ollama-models:/root/.ollama \
    --read-only --cap-drop ALL --security-opt no-new-privileges:true \
    --tmpfs /tmp:rw,noexec,nosuid,size=64m \
    "${OLLAMA_IMAGE}:${OLLAMA_TAG}@${OLLAMA_DIGEST}" \
    sh -c "ollama serve & sleep 3; ollama pull '$name'; pkill ollama"
}

# THE REPAIR FOR AN INTERRUPTED FIRST BOOT.
#
# MEASURED (NOM-307, 2026-10-19).  The Postgres entrypoint runs
# /docker-entrypoint-initdb.d ONLY on an empty data directory.  If first boot
# gets part way through and dies — an unreadable secret, a power cut, a
# container killed mid-init — every later start prints "Skipping
# initialization" and the cluster keeps whatever half of the roles it got.
# Before this command the only recovery was deleting the volume, which is a
# very large hammer for a database that is three CREATE ROLEs short.
#
# The init scripts were already written to be idempotent (IF NOT EXISTS and
# ON CONFLICT DO NOTHING throughout) precisely so they could be re-applied, so
# this re-applies them in place against the running container.
#
# WHAT IT DOES NOT DO: it does not touch a role that already exists, so it
# cannot repair a role whose PASSWORD has diverged from secrets/app_db_passwords
# (that is a different failure, and silently rotating a live role's password is
# how an "idempotent" tool locks you out of your own data).
cmd_db_init() { with_lifecycle_lock sh _db_init "$@"; }
_db_init() {
  local c=aistack-postgres
  docker ps --format '{{.Names}}' | grep -q "^${c}$" \
    || die "$c is not running.  Start the stack first:  aistack up
If it will not start, 'docker logs $c | head -40' shows what first boot did."

  info "Re-applying the first-boot database init inside $c."
  info "Every statement is IF NOT EXISTS: existing roles, databases and"
  info "passwords are left exactly as they are."

  docker exec "$c" bash /docker-entrypoint-initdb.d/01-roles-and-databases.sh \
    || die "the role/database init failed; its output is above."
  docker exec "$c" sh -c \
    'psql -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
       -f /docker-entrypoint-initdb.d/02-approval-envelope.sql >/dev/null' \
    || die "the approval-envelope schema failed to apply; see the output above."

  # Assert the outcome with the same probe the healthcheck uses, rather than
  # reporting success because two commands exited 0.
  if docker exec "$c" /usr/local/bin/aistack-pg-health; then
    info ""
    info "Done.  Every application role, database and control table is present."
    info "Docker re-runs the health probe within 10s; 'aistack status' will show healthy."
  else
    die "init ran but the cluster still does not hold what it should (output above)."
  fi
}

cmd_pin()    { render_pins; }
cmd_update() { "$ROOT/scripts/update.sh" "$@"; }
cmd_rollback(){ "$ROOT/scripts/rollback.sh" "$@"; }
cmd_backup() { with_lifecycle_lock sh with_helper_lock "$ROOT/scripts/backup.sh" "$@"; }
cmd_restore(){ with_lifecycle_lock ex "$ROOT/scripts/restore.sh" "$@"; }
cmd_drill()  { "$ROOT/scripts/drill.sh" "$@"; }
cmd_doctor() { "$ROOT/scripts/doctor.sh" "$@"; }
cmd_security_check() { "$ROOT/scripts/security-check.sh" "$@"; }
cmd_support_bundle() { "$ROOT/scripts/support-bundle.sh" "$@"; }
cmd_remove() { "$ROOT/scripts/remove.sh" "$@"; }

cmd_manifest() {
  case "${1:-}" in
    counts) python3 "$ROOT/ci/manifest_counts.py" "$ROOT" ;;
    *) die "usage: aistack manifest counts" ;;
  esac
}

cmd_render_strings() { "$ROOT/scripts/render-strings.sh" "$@"; }

cmd_samples() {
  case "${1:-}" in
    load)
      # SYNTHETIC ONLY.  These exist so the backup drill can prove CREDENTIAL
      # DECRYPTION with real ciphertext rather than reporting "0 credentials
      # restored", which proves nothing about the key travelling with the
      # archive.
      info "Importing synthetic workflows and credentials into n8n."
      info "Every value is synthetic; see samples/README.md."
      dc exec -T n8n n8n import:workflow --separate --input=/opt/aistack/workflows \
        || die "workflow import failed"
      dc exec -T n8n n8n import:credentials --input=/opt/aistack/samples/credentials.synthetic.json \
        || die "credential import failed"
      info "Done.  'aistack drill run' will now exercise credential decryption."
      ;;
    *) die "usage: aistack samples load" ;;
  esac
}

usage() {
  cat <<'EOF'
aistack — AI Stack 2026

  up                  start the stack and wait for health (bounded, 300s)
  down                stop and remove containers
  restart             down, then up
  status              counts, lifecycle lock mode, and what is running
  ps / logs / config  pass-through, with secrets redacted from logs

  models pull <name>  pull a model through the egress helper (NOT via the UI)
  models list

  db-init             re-apply the first-boot database init (idempotent
                      repair for a first boot that was interrupted)

  pin                 re-render versions.env into .env
  update              backup, pull by digest, up, bounded health gate
  rollback            return to the previous pins

  backup              nightly-style backup, encrypted, HMAC'd inventory
  restore <archive>   verify then restore; REFUSES without the HMAC key
  drill run|clean     Tier-A restore drill in a throwaway project

  doctor              health, pins, secret readability, host listeners
  security-check      image scan + config audit
  support-bundle      a redacted artefact to send when asking for help
  remove              uninstall, with an explicit prompt about volumes

  samples load        import the synthetic workflows and credentials
  manifest counts     regenerate the counts from manifest.yaml
  render-strings      re-render the frozen local-mode copy into every surface
EOF
}

case "${1:-}" in
  up) shift; cmd_up "$@" ;;
  down) shift; cmd_down "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  status) shift; cmd_status "$@" ;;
  ps) shift; cmd_ps "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  config) shift; cmd_config "$@" ;;
  models) shift; cmd_models "$@" ;;
  pin) shift; cmd_pin "$@" ;;
  db-init) shift; cmd_db_init "$@" ;;
  update) shift; cmd_update "$@" ;;
  rollback) shift; cmd_rollback "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  drill) shift; cmd_drill "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  security-check) shift; cmd_security_check "$@" ;;
  support-bundle) shift; cmd_support_bundle "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  manifest) shift; cmd_manifest "$@" ;;
  render-strings) shift; cmd_render_strings "$@" ;;
  samples) shift; cmd_samples "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command '$1' (try: aistack help)" ;;
esac
