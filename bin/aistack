#!/usr/bin/env bash
# AI Stack 2026 — the one command.
#
# Lifecycle, status and support live here so that no viewer ever has to type a
# raw `docker compose` line with the right -f flags in the right order.
#
# TWO LOCKS, AND EVERY PATH TAKES THEM IN ONE ORDER: lifecycle, then helper
# (final-design §2.1).  A process that already holds one passes its open file
# descriptor down through AISTACK_LOCK_FD_LIFECYCLE / AISTACK_LOCK_FD_HELPER,
# and the wrapper SKIPS acquisition when the variable is set — so `aistack up`
# running a helper under its own held lock cannot deadlock against itself.
# ci/invariants.py's I14 greps the command implementations for the other order.

set -euo pipefail

ROOT="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"

# Where the two locks live.  NOT unconditionally /run/aistack: that needs root
# to create, and asking for sudo to take a lock would make `aistack up` a
# privileged operation on a stack whose whole point is that it is not one.  It
# would also break rootless Docker, which 1.0 wants at Tier A.
#
# Both candidates are tmpfs, which is what the design relies on: flock is
# released by the kernel when the holder dies, and a reboot clears the lock
# entirely, so there is no stale-lock state to clean up.
#
# AND IT IS DERIVED FROM THE OPERATOR, NOT FROM WHOEVER IS CALLING.
#
# MEASURED (NOM-258, 2026-10-18).  The first version picked by the CALLER's
# privilege, which split the lock in two:
#
#     ai   -> /run/user/1000/aistack        (XDG_RUNTIME_DIR)
#     root -> /run/aistack                  (/run is writable)
#
# `aistack up` runs as the operator; `sudo bin/aistack backup` is what
# backup.sh itself tells you to run, because a complete backup has to read
# root-owned per-service secrets.  So the two commands this lock exists to
# keep apart were the two guaranteed to take DIFFERENT locks — a restore could
# run concurrently with an up and neither would wait.  Nothing fails loudly;
# the exclusion is simply absent, which is this comment's own "silently defeat
# the whole mutual-exclusion design".
#
# The operator's runtime directory is the one path both identities agree on
# AND both can write: it exists for the logged-in operator, and root can write
# anywhere.  `$(id -u)` is deliberately not used here — that is the bug.
#
# Two defects, one fix: `[ -w /run ] || [ -d … ] && [ -w … ]` also parses as
# `(A || B) && C`, so root chose /run/aistack only when it ALREADY existed and
# otherwise fell through — the opposite of the intent.
pick_rundir() {
  if [ -n "${AISTACK_RUNDIR:-}" ]; then printf '%s' "$AISTACK_RUNDIR"; return; fi
  local ouid
  ouid="$(stat -c %u "$ROOT" 2>/dev/null || true)"; : "${ouid:=$(id -u)}"
  if [ -d "/run/user/$ouid" ] && [ -w "/run/user/$ouid" ]; then
    printf '/run/user/%s/aistack' "$ouid"; return
  fi
  # No logind session for the operator (a service account, or a container).
  # /run/aistack is then the shared path, and ensure_rundir hands it to the
  # operator when root is the one who gets there first.
  if { [ -d /run/aistack ] && [ -w /run/aistack ]; } || [ -w /run ]; then
    printf '/run/aistack'; return
  fi
  printf '/tmp/aistack-%s' "$ouid"
}
RUNDIR="$(pick_rundir)"
# Exported so every script this CLI invokes agrees on where the locks live.
# Letting each one re-derive it is how a drill ends up taking a different
# lock from the serving supervisor, which would silently defeat the whole
# mutual-exclusion design.
export AISTACK_RUNDIR="$RUNDIR"
LIFECYCLE_LOCK="$RUNDIR/lifecycle.lock"
HELPER_LOCK="$RUNDIR/helper.lock"

# The serving lifetime hold's own files.  All of them are tmpfs scratch beside
# the locks, for the same reason: a reboot must clear them.
HOLDER_PID="$RUNDIR/serving.holder.pid"
HOLDER_STOP="$RUNDIR/serving.holder.stop"
HOLDER_ERR="$RUNDIR/serving.holder.err"
HOLDER_LOG="$RUNDIR/serving.holder.log"
HOLDER_ARM="$RUNDIR/serving.holder.arm"
# The grace marker.  It exists only while a live holder is armed and has not
# yet seen a container of the project, and it is how `status` and `doctor`
# tell that window apart from a hold that leaked.  See `_holder_starting`.
HOLDER_STARTING="$RUNDIR/serving.holder.starting"

# THE STARTUP GRACE, as ONE literal.  How long a freshly armed hold waits for
# the project's first container before concluding nothing is coming.
#
# It is used in three places -- the holder's own deadline, the message it logs
# when that deadline passes, and the marker it publishes for `status` and
# `doctor` -- and until now the second one was a retyped `1200s` in the
# message.  MEASURED (NOM-395 round 2) against a copy with the deadline
# shortened to 3s: the holder released after 3s and logged "within 1200s", so
# the one number an operator reads was the one number that was not enforced.
HOLDER_GRACE=1200

# The serving project's name, DERIVED rather than retyped: it is what the
# holder and `status` filter containers by, and a second literal copy of it
# here is how a `name:` change in compose.yaml turns into a holder that
# watches a project with no containers in it and releases the lock at once.
PROJECT="${COMPOSE_PROJECT_NAME:-$(awk '/^name:[[:space:]]*[^[:space:]]/{print $2; exit}' "$ROOT/compose.yaml" 2>/dev/null)}"

# `err` prints and RETURNS 1; `die` prints and EXITS 1.  The distinction is
# load-bearing inside anything `cmd_up` runs after it has armed the serving
# lifetime hold: `exit` from a function leaves the process immediately, so the
# caller's `|| rc=$?` never gets control and the release step is skipped.  A
# refusal inside `_up` must therefore be an `err` + `return`, never a `die`.
err()  { printf 'aistack: %s\n' "$*" >&2; return 1; }
die()  { err "$*" || :; exit 1; }
info() { printf '%s\n' "$*"; }

[ -f "$ROOT/compose.yaml" ] || die "no compose.yaml at $ROOT"
[ -n "$PROJECT" ] || die "compose.yaml at $ROOT declares no 'name:'.
The serving lifetime hold filters containers by the project name, and
guessing it would make the hold watch the wrong set."

ensure_rundir() {
  # MEASURED (NOM-258, 2026-10-18).  Two defects, both found by running a real
  # root-shell install and then typing a command as the operator.
  #
  # 1. Handing over the DIRECTORY is not enough.  The lock files are created
  #    later, by `exec {fd}>>"$LIFECYCLE_LOCK"`, so a root-run install left
  #       /run/user/1000/aistack/lifecycle.lock   root:root 0644
  #    inside a 0770 operator-owned directory, and the operator's very next
  #    command died with a bare
  #       bin/aistack: line 118: .../lifecycle.lock: Permission denied
  #    That is the same class as the root-owned .env, one layer further in:
  #    the install succeeds and the stack is unusable by the person who owns
  #    it.  So the lock FILES are created here and handed over too.
  #
  # 2. The old early return -- `[ -d "$RUNDIR" ] && [ -w "$RUNDIR" ] && return`
  #    -- skipped the handover whenever the directory already existed.  root
  #    can write any directory, so for root that test is always true and the
  #    chown ran only on the very first invocation.  The handover is now
  #    idempotent and runs every time root is the caller.
  if ! [ -d "$RUNDIR" ] && ! mkdir -p "$RUNDIR" 2>/dev/null; then
  die "cannot create a lock directory at $RUNDIR.
Set AISTACK_RUNDIR to a writable path on a tmpfs and try again.
It must be a tmpfs: the locks are released by the kernel when a holder dies,
and a reboot must clear them, so a lock file on persistent storage would
survive a crash as state nobody cleans up."
  fi

  local ouid ogid f
  ouid="$(stat -c %u "$ROOT" 2>/dev/null || true)"
  ogid="$(stat -c %g "$ROOT" 2>/dev/null || true)"
  # Create, never truncate: an existing lock may be held right now.
  for f in "$LIFECYCLE_LOCK" "$HELPER_LOCK"; do
    [ -e "$f" ] || : > "$f" 2>/dev/null || true
  done
  if [ "$(id -u)" = "0" ] && [ -n "$ouid" ] && [ "$ouid" != "0" ]; then
    chown "$ouid:$ogid" "$RUNDIR" 2>/dev/null || true
    chmod 0770 "$RUNDIR" 2>/dev/null || true
    for f in "$LIFECYCLE_LOCK" "$HELPER_LOCK"; do
      [ -e "$f" ] || continue
      chown "$ouid:$ogid" "$f" 2>/dev/null || true
      chmod 0660 "$f" 2>/dev/null || true
    done
  fi
  # THE HOLDER'S LOG AND ARM FILE ARE HANDED OVER TOO, and for the same reason
  # the lock files are (NOM-258's defect, one layer further out).  install.sh
  # runs `bin/aistack up` and a root-shell install would otherwise leave a
  # root-owned 0644 serving.holder.log in an operator-owned directory; the
  # operator's next `up` would fail on the `>>` redirect that starts the
  # holder, the holder would die before it took the lock, and the symptom
  # would be a 20-second wait and "the hold was not established".
  #
  # NOT the pid file, and NOT the grace marker: the existence of either is a
  # claim -- "a holder is running", "its startup grace is open" -- so an empty
  # one created here would be a lie for `_holder_pid` or `_holder_starting` to
  # disprove.  A root-owned one left by a SIGKILLed root holder is harmless
  # anyway: both are written to a `.$$` temporary and RENAMED into place, and
  # a rename needs write permission on the directory (which is handed over
  # just above), not on the file it replaces.
  for f in "$HOLDER_LOG" "$HOLDER_ARM"; do
    [ -e "$f" ] || : > "$f" 2>/dev/null || true
    if [ -e "$f" ] && [ "$(id -u)" = "0" ] && [ -n "$ouid" ] && [ "$ouid" != "0" ]; then
      chown "$ouid:$ogid" "$f" 2>/dev/null || true
      chmod 0660 "$f" 2>/dev/null || true
    fi
  done
  # Assert the outcome rather than assuming the chown worked.  A lock we
  # cannot write is not a lock, and failing here beats failing later with a
  # bare "Permission denied" from a redirect.
  [ -w "$RUNDIR" ] || die "the lock directory $RUNDIR is not writable by $(id -un).
If a root-shell install created it, re-run that install from this commit or
remove the directory and try again."
  for f in "$LIFECYCLE_LOCK" "$HELPER_LOCK"; do
    [ ! -e "$f" ] || [ -w "$f" ] || die "the lock file $f is not writable by $(id -un).
A root-shell install created it before this fix.  Remove it and try again:
  sudo rm -f $f"
  done
  return 0
}

dc() {
  # One place that knows the compose invocation.  Every caller goes through it,
  # so there is exactly one definition of "the project".
  ( cd "$ROOT" && docker compose "$@" )
}

# --- locks ------------------------------------------------------------------
# Order: LIFECYCLE, then HELPER.  Never the reverse.

with_lifecycle_lock() {
  # $1 = sh|ex, rest = command
  local mode="$1"; shift
  if [ -n "${AISTACK_LOCK_FD_LIFECYCLE:-}" ]; then
    "$@"; return $?
  fi
  ensure_rundir
  exec {fd}>>"$LIFECYCLE_LOCK"
  local flag=-s; [ "$mode" = ex ] && flag=-x
  # SAY WHY WE ARE WAITING BEFORE WAITING.  Since the serving lifetime hold
  # exists (NOM-300) the shared mode is held for as long as the stack is up,
  # so `aistack restore` on a running stack now blocks where it used to
  # proceed — correctly, because restoring over live volumes is what the
  # exclusive mode is for.  A correct refusal that looks like a hang is still
  # a support ticket, so the non-blocking attempt comes first and a failure
  # names the holder and the command that releases it.
  if ! flock -n "$flag" "$fd"; then
    info "Waiting for the lifecycle lock: $(_lock_wait_hint "$mode")"
    flock "$flag" "$fd" || die "could not take the lifecycle lock"
  fi
  AISTACK_LOCK_FD_LIFECYCLE="$fd" "$@"
  local rc=$?
  exec {fd}>&-
  return $rc
}

with_helper_lock() {
  # At most ONE helper exists at any instant.  `aistack up` holds this too, so
  # no helper runs during startup verification.
  if [ -n "${AISTACK_LOCK_FD_HELPER:-}" ]; then
    "$@"; return $?
  fi
  ensure_rundir
  exec {fd}>>"$HELPER_LOCK"
  flock -x "$fd" || die "another helper is running; at most one may exist at a time"
  AISTACK_LOCK_FD_HELPER="$fd" "$@"
  local rc=$?
  exec {fd}>&-
  return $rc
}

# --- the serving lifetime hold ----------------------------------------------
# WHY A PROCESS EXISTS WHOSE ONLY JOB IS TO HOLD A LOCK.
#
# MEASURED (NOM-300, 2026-10-18).  With nine services healthy, `aistack
# status` said the lifecycle lock was `free` and `flock -n -x` on it exited 0.
# Nothing was wrong with any service and no check said a word: `cmd_up` took
# the shared lock, ran the opposing-project check, `compose up -d` and the
# health gate inside it, and then RETURNED — which released it.  `compose up
# -d` detaches by design, so once `up` exited there was no process left whose
# lifetime was the serving lifetime, and the mutual exclusion the drill rests
# on existed only during startup.  final-design §2.1 requires the shared mode
# to be held "for as long as that project is up".
#
# The design names `aistack-serving.service` for this.  This repository ships
# no systemd unit, and `aistack up` is deliberately unprivileged (see the
# RUNDIR comment at the top — a lock that needs sudo would make starting the
# stack a privileged operation and would break rootless Docker), so the
# equivalent lifetime holder is a detached process of our own.
#
# IT TAKES ITS OWN LOCK ON ITS OWN DESCRIPTOR.  Inheriting `up`'s fd would
# have been enough to keep the lock open, but then the lock's lifetime would
# be "until every inheritor exits", which includes anything else `up` ever
# spawns.  Shared locks are compatible, so the holder can take its hold while
# `up` still holds its own, and `up` returning no longer frees anything.
#
# WHAT IT IS NOT: a supervisor.  It starts nothing, restarts nothing and
# watches no health — compose's `restart: unless-stopped` does that.  It holds
# a lock and it answers one question: is this project still up.

_hold_log() { printf '%s %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$*"; }

_serving_count() {
  # The number of RUNNING containers in the serving project, or the word
  # `unknown` when docker did not answer.
  #
  # `unknown` IS NOT 0, and keeping the two apart is the whole point of this
  # function.  During a daemon restart `docker ps` fails; reading that as "no
  # containers" would make the holder release a lock the stack still needs,
  # which is the same defect as the one above with a shorter window.
  local out
  if ! out="$(docker ps -q --filter "label=com.docker.compose.project=$PROJECT" 2>/dev/null)"; then
    printf 'unknown\n'; return 0
  fi
  [ -n "$out" ] || { printf '0\n'; return 0; }
  printf '%s\n' "$(printf '%s\n' "$out" | wc -l)"
}

_serving_running() {
  # 0 = at least one container running, 1 = none, 2 = cannot tell.
  local n; n="$(_serving_count)"
  case "$n" in
    unknown) return 2 ;;
    0)       return 1 ;;
    *)       return 0 ;;
  esac
}

_holder_pid() {
  # Prints the live holder's pid and returns 0; returns 1 when there is none.
  #
  # IT VALIDATES THE PROCESS, not just the file.  A pid file outlives a
  # SIGKILL and pids are recycled, so `kill -0` alone would let an unrelated
  # process stand in for a holder that is gone — a false "the lock is held"
  # is exactly the answer this ticket exists to stop producing.
  local pid
  [ -f "$HOLDER_PID" ] || return 1
  pid="$(head -1 "$HOLDER_PID" 2>/dev/null | tr -dc '0-9')"
  [ -n "$pid" ] || return 1
  [ -r "/proc/$pid/cmdline" ] || return 1
  tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q -e '--serving-hold-run' || return 1
  printf '%s\n' "$pid"
}

_lock_wait_hint() {
  local pid
  if pid="$(_holder_pid)"; then
    printf 'the stack is serving and holds it SHARED (hold pid %s).  Release it with `bin/aistack down`; this command continues by itself when it does.' "$pid"
    return 0
  fi
  if [ "${1:-}" = ex ]; then
    printf 'another lifecycle command holds it (a drill, a restore, a down or a backup).'
  else
    printf 'a drill or a restore holds it EXCLUSIVE.  `bin/aistack status` names the mode.'
  fi
}

_hold_run() {
  # THE HOLDER.  Runs detached; everything it says goes to $HOLDER_LOG.
  local fd rc seen=0 deadline v n
  # CLOSE WHAT WE INHERITED BEFORE TAKING ANYTHING OF OUR OWN.
  #
  # MEASURED (NOM-300, fixture drill, 2026-10-24).  The holder is spawned
  # while the arm lock is held, so it inherited that descriptor — and `flock`
  # is held for as long as ANY descriptor on the file stays open, not as long
  # as the process that took it lives.  The detached holder therefore kept the
  # arm lock for its entire life, the next `up` sat in `flock -w 120` and then
  # died with "another up or down is arming", and three separate assertions
  # failed from that one cause.
  #
  # The rule this obeys, stated generally: the holder's lifetime IS the
  # project's lifetime, so it must not keep a descriptor it did not open, or
  # it silently extends some other lock's lifetime to match its own.
  for v in AISTACK_ARM_FD AISTACK_LOCK_FD_LIFECYCLE AISTACK_LOCK_FD_HELPER; do
    n="${!v:-}"
    case "$n" in ''|*[!0-9]*) continue ;; esac
    eval "exec ${n}>&-" 2>/dev/null || true
    unset "$v"
  done
  ensure_rundir
  exec {fd}>>"$LIFECYCLE_LOCK"
  # Bounded, not blocking: if a drill or a restore holds the exclusive mode,
  # serving must not start at all, and `up` needs an answer rather than a
  # terminal that never comes back.
  if ! flock -w 10 -s "$fd"; then
    printf 'a drill or a restore holds the lifecycle lock EXCLUSIVE.\n' > "$HOLDER_ERR"
    _hold_log "could not take the shared mode in 10s; exiting"
    exit 1
  fi
  # Written whole and then renamed, so that `_holder_pid` can never read a
  # half-written number and conclude there is no holder while one holds the
  # lock.  A failure here is fatal: a hold nothing can find is worse than no
  # hold, because `down` would not release it.
  if ! { printf '%s\n' "$$" > "$HOLDER_PID.$$" && mv -f "$HOLDER_PID.$$" "$HOLDER_PID"; }; then
    printf 'cannot write the hold pid file at %s\n' "$HOLDER_PID" > "$HOLDER_ERR" 2>/dev/null || true
    _hold_log "cannot write $HOLDER_PID; releasing"
    exit 1
  fi
  _hold_log "holding SHARED for project $PROJECT (pid $$)"
  # PUBLISH THE STARTUP GRACE, so that `status` and `doctor` can tell this
  # window apart from a hold that leaked.
  #
  # MEASURED (NOM-395 round 2, 2026-10-24): `up` arms BEFORE it starts
  # anything -- which is the correct order and the thing that closes the
  # check-then-act race -- so "a holder is armed and zero containers run" is
  # true of every normal startup as well as of a leak.  Nothing outside the
  # holder could tell them apart: `serving.holder.arm` is the arm lock's
  # flock target, not a grace marker.  So `doctor` exited 1 and `status`
  # advised `bin/aistack down` in the middle of a correct cold install, and
  # that advice, followed, tears down a stack that is starting.
  #
  # The marker carries the pid AND the absolute deadline.  The pid is what
  # stops a marker left by a dead holder from describing a different live
  # one; the deadline is what lets the report say when the hold self-releases
  # instead of only that it might.
  printf '%s %s\n' "$$" "$(( $(date +%s) + HOLDER_GRACE ))" > "$HOLDER_STARTING.$$" \
    && mv -f "$HOLDER_STARTING.$$" "$HOLDER_STARTING" || {
    # NOT FATAL, unlike the pid file.  A missing marker costs a misreported
    # startup window; refusing to serve over it would cost the stack.
    rm -f "$HOLDER_STARTING.$$"
    _hold_log "cannot write $HOLDER_STARTING; the startup grace will be reported as a leak"
  }
  # SIGTERM is an optimisation, never the contract: a root-shell install
  # leaves a root-owned holder that the operator cannot signal, so the stop
  # FILE is the release channel that always works and the trap only makes it
  # faster.  (The file lives in a directory the operator owns, so the
  # operator can always create it.)
  trap '_hold_log "signalled; releasing"; rm -f "$HOLDER_PID" "$HOLDER_STARTING"; exit 0' TERM INT HUP
  # THE WAIT IS ONE SECOND AND THE DOCKER QUERY IS EVERY FIFTH, which is not
  # a tuning choice.
  #
  # MEASURED (NOM-300, fixture drill, 2026-10-24): `flock` lives on the open
  # file DESCRIPTION, and `fork` shares it — so every child the holder spawns
  # holds the lock too, for as long as that child lives.  Kill the holder
  # mid-`sleep 5` and its orphaned `sleep` kept the lock for the rest of the
  # five seconds, with no holder process for `status` or `doctor` to find.
  # `sleep 5 {fd}>&-` does NOT fix it (measured: the child's descriptor table
  # still carries the lock file), because closing one descriptor on a shared
  # description releases nothing while the other one is open.
  #
  # So the window is made small instead of pretended away: the longest-lived
  # child is now a one-second `sleep`.  The direction is the safe one in any
  # case — an inherited descriptor holds the lock slightly too LONG, which
  # refuses a drill, never admits one — and the remaining unbounded case is a
  # wedged `docker ps`, which is named here rather than left to be found.
  deadline=$(( SECONDS + HOLDER_GRACE ))
  local tick=0
  while :; do
    if [ -e "$HOLDER_STOP" ]; then _hold_log "stop requested; releasing"; break; fi
    if [ "$(( tick % 5 ))" = 0 ]; then
      # `|| rc=$?`, not `; rc=$?`: this script runs under `set -e`, and a bare
      # call that returns 1 ("nothing is running") would kill the holder on
      # its first poll instead of being a value to switch on.
      rc=0; _serving_running || rc=$?
      case "$rc" in
        0) # THE GRACE IS OVER THE MOMENT THE FIRST CONTAINER IS SEEN, not
           # when the deadline passes.  From here on, a holder with zero
           # containers means the project stopped, and the branch below
           # releases at once -- so leaving the marker would make the leak
           # state unreportable instead of only the startup one.
           if [ "$seen" = 0 ]; then
             seen=1; rm -f "$HOLDER_STARTING"
             _hold_log "first container of $PROJECT seen; the startup grace is over"
           fi ;;
        1) if [ "$seen" = 1 ]; then
             _hold_log "no container of $PROJECT is running; releasing"; break
           elif [ "$SECONDS" -ge "$deadline" ]; then
             _hold_log "no container of $PROJECT appeared within ${HOLDER_GRACE}s; releasing"; break
           fi ;;
        *) _hold_log "docker did not answer; KEEPING the hold (a lost answer is not an empty stack)" ;;
      esac
    fi
    tick=$(( tick + 1 ))
    sleep 1
  done
  # ONE removal for every loop exit -- the stop file, the project stopping and
  # the grace lapsing all leave through here -- plus the copy in the TERM trap,
  # which does not.
  rm -f "$HOLDER_PID" "$HOLDER_STARTING"
  _hold_log "released"
}

_holder_starting() {
  # 0 = the LIVE hold is still inside its startup grace: armed, and no
  # container of the project has been seen yet.  1 = anything else, including
  # no holder at all.
  #
  # IT PRINTS SOMETHING NON-EMPTY WHENEVER IT RETURNS 0 -- the seconds left,
  # or `unknown` if the marker's deadline field is unusable -- and nothing at
  # all when it returns 1.  `cmd_doctor` passes this through an environment
  # variable, where "open but I cannot say for how long" and "not open" would
  # otherwise both arrive as the empty string and the window would be
  # reported as the leak again.
  #
  # THE PID MATCH IS THE POINT.  A marker file is tmpfs scratch like the pid
  # file, but it can still outlive its holder -- a SIGKILLed holder runs
  # neither its trap nor its exit path -- and a stale marker read as "some
  # hold is starting" would excuse the next leak.  Requiring the marker to
  # name the holder `_holder_pid` just validated makes it describe that
  # holder or nothing.
  local pid marker mpid until_s left
  pid="$(_holder_pid)" || return 1
  [ -f "$HOLDER_STARTING" ] || return 1
  marker="$(head -1 "$HOLDER_STARTING" 2>/dev/null)"
  # A HERE-STRING, not a pipe: bash appends the newline, so `read` does not
  # have to be read through "it failed but filled the variables anyway".  The
  # trailing `_` swallows anything past the two fields rather than letting it
  # land in the deadline.
  read -r mpid until_s _ <<<"$marker" || true
  [ -n "${mpid:-}" ] && [ "$mpid" = "$pid" ] || return 1
  case "${until_s:-}" in
    ''|*[!0-9]*) printf 'unknown\n' ;;
    *) left=$(( until_s - $(date +%s) ))
       [ "$left" -ge 0 ] || left=0
       printf '%s\n' "$left" ;;
  esac
  return 0
}

_with_arm_lock() {
  # Arming and releasing are serialised against each other.  MEASURED while
  # writing this: two concurrent `aistack up` runs each saw no holder, each
  # spawned one, both took the shared mode (shared locks are compatible), and
  # the second pid file overwrote the first — leaving a holder nobody could
  # find, holding the lock after `down`, so the next drill was refused for
  # ever.  This lock is taken BEFORE the lifecycle lock and nothing that
  # holds the lifecycle lock waits for it, so it adds no cycle.
  local afd rc=0
  ensure_rundir
  exec {afd}>>"$HOLDER_ARM"
  flock -w 120 -x "$afd" || die "another 'aistack up' or 'aistack down' is arming or releasing the serving lifetime hold"
  # The fd number travels to the holder so the holder can CLOSE it: see
  # _hold_run.  Same convention as AISTACK_LOCK_FD_*, opposite purpose —
  # those say "it is held for you", this one says "let go of it".
  AISTACK_ARM_FD="$afd" "$@" || rc=$?
  exec {afd}>&-
  return $rc
}

_holder_arm() {
  # Spawn the holder and PROVE it took the lock before returning.
  #
  # The proof is the contract itself: while the holder holds `flock -s`, an
  # exclusive probe MUST fail.  Checking only that the pid file appeared would
  # prove that a process started, which is the weaker claim that let this
  # defect exist in the first place.  Both halves are required — the probe
  # alone would also fail if some OTHER shared holder (a backup) were running
  # and the holder had died.
  local pid deadline
  if pid="$(_holder_pid)"; then
    info "Serving lifetime hold: already held (pid $pid)."
    return 0
  fi
  rm -f "$HOLDER_PID" "$HOLDER_STOP" "$HOLDER_ERR"
  setsid "$ROOT/bin/aistack" --serving-hold-run </dev/null >>"$HOLDER_LOG" 2>&1 &
  deadline=$(( SECONDS + 20 ))
  while [ "$SECONDS" -lt "$deadline" ]; do
    if [ -s "$HOLDER_ERR" ]; then
      die "the serving lifetime hold could not be taken: $(head -1 "$HOLDER_ERR")
${ARM_FAIL_STATE:-Nothing was started.}  'bin/aistack status' names the mode that is held."
    fi
    if pid="$(_holder_pid)" && ! flock -n -x "$LIFECYCLE_LOCK" true 2>/dev/null; then
      info "Serving lifetime hold: SHARED, pid $pid (released when the project stops)."
      return 0
    fi
    sleep 0.2
  done
  _holder_let_go
  die "the serving lifetime hold was not established within 20s.
${ARM_FAIL_STATE:-Nothing was started.}  See $HOLDER_LOG."
}

_holder_let_go() {
  # Release the hold and WAIT until it is actually gone.  The predicate is
  # "no live holder", not "the lock is exclusively takeable": a concurrent
  # backup holds the shared mode too, and waiting for a free lock would make
  # `down` die during a backup it is entitled to queue behind.
  local pid deadline
  if ! pid="$(_holder_pid)"; then
    rm -f "$HOLDER_PID" "$HOLDER_STOP"
    return 0
  fi
  info "Releasing the serving lifetime hold (pid $pid)..."
  : > "$HOLDER_STOP"
  kill -TERM "$pid" 2>/dev/null || true
  deadline=$(( SECONDS + 30 ))
  while [ "$SECONDS" -lt "$deadline" ]; do
    _holder_pid >/dev/null || break
    sleep 1
  done
  if pid="$(_holder_pid)"; then
    kill -KILL "$pid" 2>/dev/null || true
    sleep 1
  fi
  rm -f "$HOLDER_STOP" "$HOLDER_PID"
  if pid="$(_holder_pid)"; then
    die "the serving lifetime hold (pid $pid) will not release.
It is probably owned by root because a root-shell install started it:
  sudo kill $pid
Nothing was stopped."
  fi
  return 0
}

# --- pins -------------------------------------------------------------------

render_pins() {
  # Render versions.env into the delimited block in .env.  I4 asserts the
  # rendered block matches the source; `doctor` re-checks, which catches a
  # Renovate PR merged without a re-render.
  local env="$ROOT/.env"
  [ -f "$env" ] || die ".env not found — run 'aistack install' first"
  python3 - "$ROOT/versions.env" "$env" <<'PY'
import sys, re
src, env = sys.argv[1], sys.argv[2]
pins = []
for line in open(src):
    s = line.strip()
    if not s or s.startswith("#"):
        continue
    if re.match(r'^[A-Z0-9_]+=', s):
        pins.append(s)
block = (
    "# AISTACK-PINS:BEGIN\n"
    "# RENDERED FROM versions.env BY `aistack install|update|pin`.  DO NOT EDIT.\n"
    + "\n".join(pins) + "\n"
    "# AISTACK-PINS:END\n"
)
text = open(env).read()
pat = re.compile(r"# AISTACK-PINS:BEGIN.*?# AISTACK-PINS:END\n", re.S)
if pat.search(text):
    text = pat.sub(block, text)
else:
    text = text.rstrip("\n") + "\n\n" + block
open(env, "w").write(text)
print("rendered %d pins into .env" % len(pins))
PY
  chmod 0600 "$env"
}

# --- commands ---------------------------------------------------------------

cmd_up() {
  # THE HOLD IS TAKEN BEFORE ANYTHING STARTS AND IT OUTLIVES THIS PROCESS.
  # That is the whole fix (NOM-300): `with_lifecycle_lock sh _up` took the
  # shared mode for the duration of startup and released it on return.
  #
  # The hold is NOT expressed through AISTACK_LOCK_FD_LIFECYCLE and `_up` does
  # not inherit it.  That variable means "an ancestor holds the lifecycle lock
  # on this process's behalf"; the holder is not an ancestor, it is a sibling
  # that will outlive us, and a nested command that skipped acquisition on
  # that basis would be skipping it on the strength of a descriptor it does
  # not have.  Nothing `_up` runs takes the lifecycle lock, so there is
  # nothing to pass down.
  _with_arm_lock _holder_arm
  # The opposing-project check and `compose up` therefore run INSIDE the
  # hold, which is what closes the check-then-act race §2.1 names.
  local rc=0
  _up "$@" || rc=$?
  if [ "$rc" = 0 ]; then
    # SUCCESS IS RE-ASSERTED, NOT ASSUMED.  `up` arming the hold 25 minutes
    # ago is not the same claim as `up` exiting 0 with the hold held.
    #
    # MEASURED (NOM-395 round 2, 2026-10-24, fixture with the grace shortened
    # to 3s): `compose up` pulls every missing image BEFORE the first
    # container starts, and ollama, open-webui and docling are multi-GB, so a
    # cold install can put the first `running` container past the holder's
    # 1200s startup grace.  The holder then logged "no container appeared
    # within 1200s; releasing" and exited -- and the containers started, the
    # health gate passed, `up` printed success and RETURNED 0.  Nine services
    # serving, lifecycle lock free: this ticket's end state reached with no
    # reboot, and reported as a success on the way there.
    #
    # Re-asserting here also covers a holder that died mid-startup for any
    # other reason, which is the more general property and the reason this is
    # not a longer grace.
    _with_arm_lock _holder_reassert
  else
    _with_arm_lock _holder_release_if_idle
  fi
  return $rc
}

_holder_reassert() {
  # Prove the hold is STILL real, and re-arm if it is not.
  #
  # The predicate is `_holder_arm`'s own proof, both halves of it: a validated
  # holder process AND a failing exclusive probe.  The pid file alone is the
  # weaker claim this whole ticket family exists to stop accepting, and the
  # probe alone would also fail while a backup held the shared mode with no
  # serving holder at all.
  #
  # `ensure_rundir` has run (`_with_arm_lock` calls it), which the probe needs:
  # `flock` cannot OPEN a lock file whose directory is gone, and that failure
  # is indistinguishable from "something holds it" -- a false green for
  # exactly the post-reboot state.
  local pid
  if pid="$(_holder_pid)"; then
    if ! flock -n -x "$LIFECYCLE_LOCK" true 2>/dev/null; then
      return 0
    fi
    # A live `--serving-hold-run` process that does not hold the lock is not a
    # hold, and `_holder_arm` would return early on the pid file alone, so it
    # has to go before the re-arm can do anything.
    info "The serving lifetime hold (pid $pid) is no longer holding the lock; re-arming."
    _holder_let_go
  else
    info "The serving lifetime hold lapsed while the stack was starting; re-arming."
  fi
  # `local` is DYNAMICALLY scoped in bash, so this reaches `_holder_arm`'s
  # refusal text and nothing else.  `up`'s first arm runs before anything has
  # started, where "Nothing was started" is true; here the project is already
  # serving, where it would be a false statement in the one message an
  # operator reads when the hold could not be taken.
  local ARM_FAIL_STATE="THE STACK IS RUNNING WITHOUT THE HOLD -- nothing was stopped, but
the kernel is not enforcing the drill interlock.  'bin/aistack up' retries the
re-arm without restarting anything; 'bin/aistack down' stops the stack."
  _holder_arm
}

_holder_release_if_idle() {
  # `up` failed.  If nothing came up there is nothing for the lock to protect,
  # so holding it would only block the next drill for ever.  If something DID
  # come up — a partial start — the hold stays, because a drill alongside half
  # a stack is precisely what it exists to prevent.
  local rc=0
  _serving_running || rc=$?
  case "$rc" in
    0) info "The serving lifetime hold stays: containers are still running."
       info "'bin/aistack down' stops them and releases it." ;;
    1) _holder_let_go ;;
    *) info "The serving lifetime hold stays: docker did not answer, so whether"
       info "anything is running is unknown, and keeping it is the safe answer." ;;
  esac
  return 0
}
_up() {
  # The drill must be excluded BY THE LOCK MODE, not by a count of holders.
  # We hold shared; the drill holds exclusive; the kernel serialises them.
  # The opposing-project check runs INSIDE the hold, which is what closes the
  # check-then-act race.
  # `err ... || return 1`, NOT `die`.  MEASURED (NOM-300 review, 2026-10-24):
  # `die` is `exit 1`, so this refusal left the process before `cmd_up`'s
  # `|| rc=$?` could run `_holder_release_if_idle` — and the hold stayed armed
  # for up to the 1200s startup grace with nothing serving and no container
  # ever started.  That is the mirror image of this ticket's own defect: the
  # lock stops tracking the serving state, here by being held while nothing
  # serves.  The `|| return 1` form is correct whether or not `set -e` is
  # suppressed at the call site, which `_up`'s single `|| rc=$?` caller does
  # today and a future caller might not.
  if docker ps -a --format '{{.Names}}' | grep -q '^restore-drill-'; then
    err "a restore drill is running or was left behind: $(docker ps -a --format '{{.Names}}' | grep '^restore-drill-' | tr '\n' ' ')
Serving will not start while drill containers exist.  Run 'aistack drill clean'." || return 1
  fi
  info "Starting (profiles: ${COMPOSE_PROFILES:-$(grep -E '^COMPOSE_PROFILES=' "$ROOT/.env" 2>/dev/null | cut -d= -f2-)})"
  # `compose up` CAN FAIL BEFORE THE HEALTH GATE EVER RUNS, and when it does
  # its last line names the wrong thing.
  #
  # MEASURED (NOM-307, 2026-10-19): a half-initialised Postgres ended the
  # install with
  #     dependency failed to start: container aistack-postgres is unhealthy
  # naming the one service that was, by its own probe at that moment, fine —
  # while the actual cause was seven WARN lines from gen-secrets.sh earlier in
  # the same log.  With `set -e` this used to abort the function here and the
  # explanation below never ran at all.
  if ! dc up -d --remove-orphans; then
    info ""
    info "'docker compose up' gave up.  What each container itself reports:"
    _explain_unhealthy
    return 1
  fi
  _health_gate
}

# The state of every container, as one line of `service container state health`.
#
# IT FAILS INSTEAD OF RETURNING NOTHING.  The previous version swallowed every
# exception per line and printed an empty list, so a `compose ps` that errored
# — or that one day emits a JSON array instead of one object per line —
# produced zero bad services and the gate said "All services healthy."  That
# is the same shape of defect as NOM-307's silent `except ImportError`: an
# unanswered question read as a reassuring answer.
_service_table() {
  local json
  json="$(dc ps "$@" --format json 2>/dev/null)" || return 1
  [ -n "$json" ] || return 1
  printf '%s\n' "$json" | python3 -c '
import json, sys
rows = []
for line in sys.stdin:
    line = line.strip()
    if not line:
        continue
    d = json.loads(line)          # a shape we cannot parse is an ERROR, not "healthy"
    rows.append((d.get("Service") or "?", d.get("Name") or "?",
                 (d.get("State") or "").lower(), (d.get("Health") or "").lower()))
if not rows:
    sys.exit(3)
for r in rows:
    print(*r)
'
}

_not_ready() {
  # $1 = the table.  A service is not ready when it is not running, or it has
  # a probe that is starting or failing.
  printf '%s\n' "$1" | awk '$3!="running" || $4=="starting" || $4=="unhealthy" {print $1}'
}

# WHAT THE CONTAINER SAYS ABOUT ITSELF, not what compose concluded.
#
# The last health-probe OUTPUT is printed first and deliberately: it is the one
# line that names a cause.  config/postgres/healthcheck.sh, for instance, says
# which roles and databases are missing and which command repairs them, and
# none of that reaches the terminal if only `docker compose`'s own summary is
# shown.
_explain_unhealthy() {
  local table svc name
  if ! table="$(_service_table -a)"; then
    info "  (could not read 'docker compose ps' — try: docker compose ps -a)"
    return 0
  fi
  printf '%s\n' "$table" | awk '{printf "  %-16s %-24s %s%s\n", $1, $2, $3, ($4=="" ? "" : "/" $4)}'
  for svc in $(_not_ready "$table"); do
    name="$(printf '%s\n' "$table" | awk -v s="$svc" '$1==s {print $2; exit}')"
    info ""
    info "--- $svc: last health-probe output ---"
    docker inspect --format \
      '{{range .State.Health.Log}}exit {{.ExitCode}}: {{.Output}}{{end}}' "$name" 2>/dev/null \
      | tail -12 | "$ROOT/scripts/redact.sh" || info "  (no healthcheck on this service)"
    info "--- $svc: last 50 log lines (redacted) ---"
    dc logs --tail 50 "$svc" 2>&1 | "$ROOT/scripts/redact.sh" || true
  done
  info ""
  info "To roll back to the previous pins:   aistack rollback"
  info "To collect a shareable artefact:     aistack support-bundle"
}

_health_gate() {
  # Bounded.  A health gate that waits forever is a hang with a progress bar.
  local deadline=$(( SECONDS + 300 )) table unhealthy
  info "Waiting for health (up to 300s)..."
  while [ "$SECONDS" -lt "$deadline" ]; do
    if ! table="$(_service_table)"; then
      info ""
      info "COULD NOT READ THE STACK'S STATE from 'docker compose ps'."
      info "That is not a pass.  Run 'docker compose ps' here and look at the error."
      return 1
    fi
    unhealthy="$(_not_ready "$table" | tr '\n' ' ')"
    [ -z "${unhealthy// /}" ] && { info "All services healthy."; return 0; }
    sleep 5
  done
  # Name the service and print its last health output and 50 REDACTED log
  # lines, plus the exact rollback command.  A health-gate failure that says
  # only "unhealthy" sends the viewer to a screenshot of their terminal, which
  # is the thing support-bundle exists to replace.
  info ""
  info "NOT HEALTHY after 300s: $unhealthy"
  _explain_unhealthy
  return 1
}

cmd_down() {
  # RELEASE FIRST, THEN TAKE THE EXCLUSIVE MODE.  The holder's shared hold
  # would otherwise block the exclusive acquisition below for ever, and a
  # `down` that hangs is a worse bug than the one this fixed.
  #
  # THE WINDOW THIS LEAVES, STATED: between the holder letting go and `down`
  # acquiring, serving containers are still running with nothing holding the
  # lock, so a drill started in that instant takes the exclusive mode.  It is
  # closed by the drill's OTHER guard — inside its own hold the drill refuses
  # when any `aistack-*` container exists — which is why NOM-300 keeps both
  # guards rather than replacing one with the other.  The lock establishes
  # non-concurrency; the container check covers the handover.
  _with_arm_lock _holder_let_go
  with_lifecycle_lock ex dc down --remove-orphans
}
cmd_restart() { cmd_down; cmd_up; }
cmd_logs()    { dc logs "${@:---tail=200}" | "$ROOT/scripts/redact.sh"; }
cmd_config()  { dc config "$@"; }
cmd_ps()      { dc ps; }

cmd_status() {
  # Steady-state and helper counts are printed SEPARATELY, and the lifecycle
  # mode currently held is named (final-design §2.1).  One number could not
  # carry all three honestly.
  local steady helpers mode holder srv left
  # `grep -v | grep -c .`, not `grep -vc`.  MEASURED (NOM-300, 2026-10-24):
  # with the stack down, `compose ps --services --filter status=running`
  # prints a single newline rather than nothing, so `grep -vc` counted that
  # empty line as a service and `status` said "steady-state services running:
  # 1" with zero containers on the host.  Counting only non-empty lines is
  # the fix; it has been wrong since the MVP commit.
  steady="$(dc ps --services --filter status=running 2>/dev/null \
            | grep -v -E '^(model-puller|backup-helper|agentgateway-verify)$' \
            | grep -c . || true)"
  helpers="$(docker ps --format '{{.Names}}' | grep -cE '^aistack-(model-puller|backup-helper|agentgateway-verify)' || true)"
  if   [ -e "$LIFECYCLE_LOCK" ] && flock -n -x "$LIFECYCLE_LOCK" true 2>/dev/null; then mode="free"
  elif [ -e "$LIFECYCLE_LOCK" ] && flock -n -s "$LIFECYCLE_LOCK" true 2>/dev/null; then mode="shared (serving)"
  elif [ -e "$LIFECYCLE_LOCK" ]; then mode="exclusive (a drill holds it)"
  else mode="free (no lock file)"; fi

  # THE MODE ALONE CANNOT ANSWER "IS THE SERVING LIFETIME HOLD THERE".
  # `aistack backup` holds the shared mode too, so `shared` does not imply the
  # hold; and a hold that was killed leaves the lock FREE while nine
  # containers keep serving — which is the state NOM-300 was filed about and
  # therefore the one `status` has to be able to name.  Three facts, printed
  # as three facts.
  holder="$(_holder_pid || true)"
  srv=0; _serving_running || srv=$?
  # "A HOLDER IS ARMED AND NOTHING RUNS" IS TWO STATES, NOT ONE, and the
  # startup one is the correct order rather than a defect -- see
  # `_holder_starting`.  `left` is the seconds until the hold self-releases if
  # nothing ever starts, or empty when the marker could not say.
  if [ -n "$holder" ] && [ "$srv" = 1 ] && left="$(_holder_starting)"; then
    case "$left" in
      ''|unknown) left="" ;;
      *) left=" (it releases by itself in ${left}s if none starts)" ;;
    esac
    mode="$mode   -- the serving lifetime hold (pid $holder) is ARMED and waiting for the project's first container${left}"
  elif [ -n "$holder" ] && [ "$srv" = 1 ]; then
    mode="$mode   -- the serving lifetime hold (pid $holder) is held while NOTHING runs; release it with 'bin/aistack down'"
  elif [ -n "$holder" ]; then
    mode="$mode   (serving lifetime hold: pid $holder)"
  elif [ "$srv" = 0 ]; then
    mode="$mode   -- NO SERVING LIFETIME HOLD while $(_serving_count) container(s) run; re-arm with 'bin/aistack up'"
  elif [ "$srv" = 2 ]; then
    mode="$mode   (no serving lifetime hold; docker did not answer, so what is running is unknown)"
  fi

  printf '\nAI Stack 2026\n'
  printf '  steady-state services running : %s\n' "${steady:-0}"
  printf '  helpers running               : %s   (ceiling 1 — the helper lock)\n' "${helpers:-0}"
  printf '  lifecycle lock                : %s\n' "$mode"
  printf '  profiles                      : %s\n' "$(grep -E '^COMPOSE_PROFILES=' "$ROOT/.env" 2>/dev/null | cut -d= -f2- || echo '(none)')"
  printf '\n'
  sed -n '/AISTACK-LOCAL-MODE:BEGIN/,/AISTACK-LOCAL-MODE:END/p' "$ROOT/.env" 2>/dev/null \
    | grep -v 'AISTACK-LOCAL-MODE' | sed 's/^# \?/  /'
  printf '\n'
  dc ps
}

cmd_models() {
  case "${1:-}" in
    pull)
      shift
      [ $# -ge 1 ] || die "usage: aistack models pull <name>"
      with_lifecycle_lock sh with_helper_lock _model_pull "$@"
      ;;
    list)
      # shellcheck disable=SC1091
      source "$ROOT/versions.env"
      # --entrypoint sh: the ollama image's ENTRYPOINT *is* `ollama`, so a bare
      # `sh -c …` argument is parsed as the `ollama sh` SUBCOMMAND and dies with
      # `unknown command "sh" for "ollama"`.  MEASURED (NOM-302, 2026-10-19):
      # both this and `models pull` were broken this way, which is why QA found
      # an empty `ollama list` after a successful install — the pull never ran.
      docker run --rm --network aistack-inference \
        --entrypoint sh \
        "${OLLAMA_IMAGE}:${OLLAMA_TAG}@${OLLAMA_DIGEST}" \
        -c 'OLLAMA_HOST=http://ollama:11434 ollama list'
      ;;
    *) die "usage: aistack models {pull <name>|list}" ;;
  esac
}
_model_pull() {
  # Ollama itself sits on `inference`, which is internal and has NO route off
  # the host.  The puller is a SHORT-LIVED helper on `egress` writing the same
  # named volume.  Pulling a model from the Open WebUI UI does not work, and
  # the docs say so rather than leaving the viewer to discover it.
  local name="$1"
  # shellcheck disable=SC1091
  source "$ROOT/versions.env"

  # The `egress` bridge is created HERE, for the life of the helper, rather
  # than declared in compose.
  #
  # This is deliberate and it is stronger than the declared form: compose
  # prunes a network no service references, so declaring `egress` there and
  # attaching nothing to it produced a bridge that either did not exist or
  # existed permanently depending on compose's mood.  Creating it per-pull
  # means THE ONE NAT-CAPABLE BRIDGE IN THE STACK DOES NOT EXIST AT STEADY
  # STATE AT ALL.  `edge` is then the only non-internal bridge while the stack
  # is merely running, which is a smaller surface than the design assumed, and
  # I11 checks the flags of whichever bridges exist.
  if ! docker network inspect aistack-egress >/dev/null 2>&1; then
    docker network create --subnet 172.31.246.0/29 aistack-egress >/dev/null
  fi
  trap 'docker network rm aistack-egress >/dev/null 2>&1 || true' RETURN

  info "Pulling '$name' through the model-puller helper (egress), not through Ollama."
  # --entrypoint sh, for the reason spelled out in `models list` above: without
  # it docker hands `sh -c …` to the image's `ollama` ENTRYPOINT as a
  # subcommand name and the pull exits 1 having downloaded nothing.
  docker run --rm --name aistack-model-puller \
    --network aistack-egress \
    -v aistack-ollama-models:/root/.ollama \
    --read-only --cap-drop ALL --security-opt no-new-privileges:true \
    --tmpfs /tmp:rw,noexec,nosuid,size=64m \
    --entrypoint sh \
    "${OLLAMA_IMAGE}:${OLLAMA_TAG}@${OLLAMA_DIGEST}" \
    -c "ollama serve & sleep 3; ollama pull '$name'; pkill ollama"
}

# THE REPAIR FOR AN INTERRUPTED FIRST BOOT.
#
# MEASURED (NOM-307, 2026-10-19).  The Postgres entrypoint runs
# /docker-entrypoint-initdb.d ONLY on an empty data directory.  If first boot
# gets part way through and dies — an unreadable secret, a power cut, a
# container killed mid-init — every later start prints "Skipping
# initialization" and the cluster keeps whatever half of the roles it got.
# Before this command the only recovery was deleting the volume, which is a
# very large hammer for a database that is three CREATE ROLEs short.
#
# The init scripts were already written to be idempotent (IF NOT EXISTS and
# ON CONFLICT DO NOTHING throughout) precisely so they could be re-applied, so
# this re-applies them in place against the running container.
#
# WHAT IT DOES NOT DO: it does not touch a role that already exists, so it
# cannot repair a role whose PASSWORD has diverged from secrets/app_db_passwords
# (that is a different failure, and silently rotating a live role's password is
# how an "idempotent" tool locks you out of your own data).
cmd_db_init() { with_lifecycle_lock sh _db_init "$@"; }
_db_init() {
  local c=aistack-postgres
  docker ps --format '{{.Names}}' | grep -q "^${c}$" \
    || die "$c is not running.  Start the stack first:  aistack up
If it will not start, 'docker logs $c | head -40' shows what first boot did."

  info "Re-applying the first-boot database init inside $c."
  info "Every statement is IF NOT EXISTS: existing roles, databases and"
  info "passwords are left exactly as they are."

  docker exec "$c" bash /docker-entrypoint-initdb.d/01-roles-and-databases.sh \
    || die "the role/database init failed; its output is above."
  docker exec "$c" sh -c \
    'psql -v ON_ERROR_STOP=1 -U "$POSTGRES_USER" -d "$POSTGRES_DB" \
       -f /docker-entrypoint-initdb.d/02-approval-envelope.sql >/dev/null' \
    || die "the approval-envelope schema failed to apply; see the output above."

  # Assert the outcome with the same probe the healthcheck uses, rather than
  # reporting success because two commands exited 0.
  if docker exec "$c" /usr/local/bin/aistack-pg-health; then
    info ""
    info "Done.  Every application role, database and control table is present."
    info "Docker re-runs the health probe within 10s; 'aistack status' will show healthy."
  else
    die "init ran but the cluster still does not hold what it should (output above)."
  fi
}

cmd_pin()    { render_pins; }
cmd_update() { "$ROOT/scripts/update.sh" "$@"; }
cmd_rollback(){ "$ROOT/scripts/rollback.sh" "$@"; }
cmd_backup() { with_lifecycle_lock sh with_helper_lock "$ROOT/scripts/backup.sh" "$@"; }
cmd_restore(){ with_lifecycle_lock ex "$ROOT/scripts/restore.sh" "$@"; }
# READ-ONLY, so it takes the SHARED lock, not the exclusive one: asking what
# an archive contains must not wait behind -- or block -- a backup or an
# `up`.  It is restore.sh's own verify phase, not a second implementation, so
# what `verify` says and what a real restore says cannot drift (NOM-378).
#
# OUT OF BAND, not an appended flag.  This line was
# `restore.sh "$@" --verify-only`, which put the flag after the caller's
# arguments: `aistack verify a.enc --into-drill-project` made
# --into-drill-project eat `--verify-only` as its project name and execution
# continued past the read-only exit.  An environment variable cannot be
# consumed by another option's argument, so read-only no longer depends on how
# argv lands.
cmd_verify() {
  export AISTACK_VERIFY_ONLY=1
  with_lifecycle_lock sh "$ROOT/scripts/restore.sh" "$@"
}
cmd_drill()  { "$ROOT/scripts/drill.sh" "$@"; }
# The serving-hold facts are computed HERE and passed in, rather than
# re-derived in doctor.sh: one implementation of "is there a live holder"
# means `status` and `doctor` cannot disagree about it.  doctor.sh already
# says so when it is run directly instead of through the CLI, because only
# the CLI knows which lock directory was picked.
#
# AISTACK_SERVING_STARTING is the third fact, added in NOM-395 round 2 for the
# same reason the first two are here: `doctor` has to tell a hold that is
# waiting for its first container apart from a hold that leaked, and only the
# CLI can read the marker the holder publishes.  It is the seconds left in the
# grace, `0`+ when the window is open, or EMPTY when it is not -- so an older
# doctor.sh that ignores it keeps exactly its old behaviour.
cmd_doctor() {
  AISTACK_SERVING_HOLDER="$(_holder_pid || true)" \
  AISTACK_SERVING_COUNT="$(_serving_count)" \
  AISTACK_SERVING_STARTING="$(_holder_starting || true)" \
    "$ROOT/scripts/doctor.sh" "$@"
}
cmd_security_check() { "$ROOT/scripts/security-check.sh" "$@"; }
# No lock: the suite reads the repo and drives throwaway fixtures. The one
# test that re-runs the installer (the root tier) takes install.sh's own locks.
cmd_test() { "$ROOT/tests/run.sh" "$@"; }
cmd_support_bundle() { "$ROOT/scripts/support-bundle.sh" "$@"; }
cmd_remove() { "$ROOT/scripts/remove.sh" "$@"; }

cmd_manifest() {
  case "${1:-}" in
    counts) python3 "$ROOT/ci/manifest_counts.py" "$ROOT" ;;
    *) die "usage: aistack manifest counts" ;;
  esac
}

cmd_render_strings() { "$ROOT/scripts/render-strings.sh" "$@"; }

cmd_samples() {
  case "${1:-}" in
    load)
      # THE OLD COMMAND, KEPT BECAUSE THE DRILL DEPENDS ON IT AND ONLY ON IT.
      #
      # `drill run` needs n8n credential CIPHERTEXT to decrypt, so that a
      # restore reporting "0 credentials restored" cannot pass for a restore
      # that proved the key travelled with the archive.  That is all this
      # subcommand was ever for, and it still does exactly that.
      #
      # IT IS NOT A DEMO, which is the lesson of NOM-302: it imported four
      # workflows, exited 0, and not one of them could run — no weights, no
      # credentials bound, no tables to write to, no question to ask.  An
      # import is a file landing in a database.  Use `samples setup` for
      # something a person can run and check.
      info "Importing synthetic workflows and credentials into n8n."
      info "Every value is synthetic; see samples/README.md."
      dc exec -T n8n n8n import:workflow --separate --input=/opt/aistack/workflows \
        || die "workflow import failed"
      dc exec -T n8n n8n import:credentials --input=/opt/aistack/samples/credentials.synthetic.json \
        || die "credential import failed"
      info "Done.  'aistack drill run' will now exercise credential decryption."
      info ""
      info "This imported the templates; it did NOT make them runnable."
      info "For a demo you can run and check: aistack samples setup, then"
      info "aistack samples run all.  See docs/samples.md."
      ;;
    setup|run|approve|teardown)
      "$ROOT/scripts/samples.sh" "$@"
      ;;
    *) die "usage: aistack samples {setup|run [W1|W2|W3|W4|P2|all]|approve <action-id>|teardown|load}" ;;
  esac
}

usage() {
  cat <<'EOF'
aistack — AI Stack 2026

  up                  start the stack and wait for health (bounded, 300s)
  down                stop and remove containers
  restart             down, then up
  status              counts, lifecycle lock mode, and what is running
  ps / logs / config  pass-through, with secrets redacted from logs

  models pull <name>  pull a model through the egress helper (NOT via the UI)
  models list

  db-init             re-apply the first-boot database init (idempotent
                      repair for a first boot that was interrupted)

  pin                 re-render versions.env into .env
  update              backup, pull by digest, up, bounded health gate
  rollback            return to the previous pins

  backup              nightly-style backup, encrypted, HMAC'd inventory
  restore <archive>   verify then restore; REFUSES without the HMAC key
  verify <archive>    verify only: say which databases it can and cannot
                      return, change nothing
  drill run|clean     Tier-A restore drill in a throwaway project

  doctor              health, pins, secret readability, host listeners
  security-check      image scan + config audit
  support-bundle      a redacted artefact to send when asking for help
  remove              uninstall, with an explicit prompt about volumes

  samples setup       preload weights, build the demo database, bind the
                      synthetic credentials, import the templates (four
                      imported; W1/W3/W4 executable, W2 deferred)
  samples run [case]  run W1/W3/W4/P2 and CHECK the outputs (default: all)
  samples approve ID  the human decision step in W3's approval envelope
  samples teardown    remove everything 'samples setup' created
  samples load        import only, for the backup drill's ciphertext
  manifest counts     regenerate the counts from manifest.yaml
  render-strings      re-render the frozen local-mode copy into every surface

  test [tier]         run the test suite (tests/run.sh). Tiers: fast
                      (default; no docker, no root, no arguments),
                      stack (needs docker), root (needs sudo),
                      archive (needs --archive <path>), all, list.
                      Exit 1 a test failed, 2 a test REFUSED and so
                      measured nothing, 0 clean. `aistack test list`
                      prints every test and what it needs. See the
                      Tests section of README.md.
EOF
}

case "${1:-}" in
  # Not in `usage`, and spelled as a flag rather than a word so that it cannot
  # be mistaken for something an operator is meant to type: this is the
  # detached serving lifetime hold, started by `up` and released by `down`.
  # `_holder_pid` identifies the process by this exact string in its cmdline.
  --serving-hold-run) shift; _hold_run ;;
  up) shift; cmd_up "$@" ;;
  down) shift; cmd_down "$@" ;;
  restart) shift; cmd_restart "$@" ;;
  status) shift; cmd_status "$@" ;;
  ps) shift; cmd_ps "$@" ;;
  logs) shift; cmd_logs "$@" ;;
  config) shift; cmd_config "$@" ;;
  models) shift; cmd_models "$@" ;;
  pin) shift; cmd_pin "$@" ;;
  db-init) shift; cmd_db_init "$@" ;;
  update) shift; cmd_update "$@" ;;
  rollback) shift; cmd_rollback "$@" ;;
  backup) shift; cmd_backup "$@" ;;
  restore) shift; cmd_restore "$@" ;;
  verify) shift; cmd_verify "$@" ;;
  drill) shift; cmd_drill "$@" ;;
  doctor) shift; cmd_doctor "$@" ;;
  security-check) shift; cmd_security_check "$@" ;;
  support-bundle) shift; cmd_support_bundle "$@" ;;
  remove) shift; cmd_remove "$@" ;;
  manifest) shift; cmd_manifest "$@" ;;
  render-strings) shift; cmd_render_strings "$@" ;;
  test) shift; cmd_test "$@" ;;
  samples) shift; cmd_samples "$@" ;;
  ""|-h|--help|help) usage ;;
  *) die "unknown command '$1' (try: aistack help)" ;;
esac
